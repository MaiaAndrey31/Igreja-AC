# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase (banco/auth — ver src/lib/firebase)
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*firebase-adminsdk*.json
serviceAccountKey.json

# Legado: uploads do painel iam para disco local aqui antes da migração para
# o Vercel Blob (ver src/lib/upload.ts) — uploads novos não usam mais esta
# pasta. Mantido por enquanto para não quebrar referências antigas já salvas
# no Firestore por quem rodou o app localmente antes da migração.
/public/uploads/*
!/public/uploads/.gitkeep
