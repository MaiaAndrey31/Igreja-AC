# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase (banco/auth — ver src/lib/firebase)
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*firebase-adminsdk*.json
serviceAccountKey.json

# uploads de usuário (mídia enviada pelo painel admin — disco local, ver
# src/lib/upload.ts)
/public/uploads/*
!/public/uploads/.gitkeep
